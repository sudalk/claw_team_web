# ClawTeam Web 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ============ API 配置 ============
# API 监听地址
# CLAWTEAM_WEB_HOST=0.0.0.0

# API 端口
# CLAWTEAM_WEB_PORT=8000

# ClawTeam 数据目录（默认 ~/.clawteam）
# CLAWTEAM_WEB_CLAWTEAM_DIR=~/.clawteam

# ============ LLM 配置 ============
# LLM 服务提供商: anthropic | minimax
CLAWTEAM_WEB_LLM_PROVIDER=minimax

# MiniMax API（国内可用，兼容 Anthropic 格式）
CLAWTEAM_WEB_LLM_BASE_URL=https://api.minimaxi.com/anthropic/v1
CLAWTEAM_WEB_LLM_API_KEY=your_minimax_api_key

# 或者使用 Anthropic 原生 API
# CLAWTEAM_WEB_LLM_PROVIDER=anthropic
# CLAWTEAM_WEB_LLM_API_KEY=sk-ant-xxx

# LLM 模型
# MiniMax: application-3.5-sonnet-20250514
# Anthropic: claude-sonnet-4-20250514
CLAWTEAM_WEB_LLM_MODEL=application-3.5-sonnet-20250514

# LLM 参数
# CLAWTEAM_WEB_LLM_MAX_TOKENS=8192
# CLAWTEAM_WEB_LLM_TEMPERATURE=0.7

# ============ 执行配置 ============
# 执行超时时间（秒）
# CLAWTEAM_WEB_EXECUTION_TIMEOUT=3600

# 任务状态轮询间隔（秒）
# CLAWTEAM_WEB_TASK_POLL_INTERVAL=5
